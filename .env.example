# Guardian AI Frontend Configuration
# =============================================
# COPY FILE NÀY THÀNH .env VÀ ĐIỀN IP CỦA MÁY BACKEND
# =============================================

# IP máy chạy backend (không dùng localhost vì app mobile cần kết nối từ điện thoại)
# Cách xem IP: ipconfig (Windows) hoặc ifconfig (Mac/Linux)
API_BASE_URL=http://192.168.1.XX:8000/api/v1
WS_BASE_URL=ws://192.168.1.XX:8000/api/v1/realtime/ws
